{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "statement",
    "source_url",
    "observed_at",
    "evidence_type",
    "direction",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_published_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "event_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_type": {
      "enum": [
        "primary",
        "user-report",
        "independent",
        "founder-claim",
        "investor-claim",
        "analyst-inference"
      ]
    },
    "direction": {
      "enum": [
        "support",
        "contradict",
        "context",
        "unknown"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high",
        "unassessed"
      ]
    },
    "limitations": {
      "type": "string"
    }
  }
}
